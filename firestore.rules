rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /oppslag/{postId} {
      // Kun publiserte oppslag kan leses av besøkende.
      allow get, list: if resource.data.published == true || (request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID');
      // Bare den godkjente Google-kontoen kan endre data.
      allow create: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
        && request.resource.data.keys().hasOnly(['title','body','category','pinned','published','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000
        && request.resource.data.pinned is bool && request.resource.data.published is bool;
      allow update: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
        && request.resource.data.keys().hasOnly(['title','body','category','pinned','published','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 150
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000
        && request.resource.data.pinned is bool && request.resource.data.published is bool;
      allow delete: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }
  }
}
